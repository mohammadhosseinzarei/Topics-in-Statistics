set.seed(111)
n <- 5e4
# MC
u_standard <- runif(n)
est_standard <- mean(exp(u_standard))
# MC Antithetic
u_antithetic <- runif(n)
est_antithetic <- mean((exp(u_antithetic) +
exp(1 - u_antithetic)) / 2)
I_exact <- exp(1) - 1
est_antithetic
