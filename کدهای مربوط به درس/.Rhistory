CI_lower<-(xbar-ybar) - t_crit * s_sp * sqrt(1/n1 + 1 / n2)
CI_upper<-(xbar-ybar) + t_crit * s_sp * sqrt(1/n1 + 1 / n2)
if (abs(t_test) > t_crit){
cat ("reject hapothesis H0")
} else {
cat ("Acc hapothesis H0 ")
}
