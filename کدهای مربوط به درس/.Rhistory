sp<-((n1-1)*sd1 + (n2 -1)*sd2) / (n1+n2-2)
s_sp<-sqrt(sp)
t_test<-(xbar - ybar)/(s_sp*sqrt((1/n1 + 1/n2)))
alpha<-0.05
df<- n1 + n2 -2
t_crit<- qt(1-alpha/2, df )
