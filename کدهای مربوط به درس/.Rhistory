cat ("Acc hapothesis H0 ")
}
set.seed(1245)
x <- rnorm(30, mean=13, sd=3)
y <- rnorm(25, mean=12, sd=3)
# sample statistics
n1 <- length(x)
n2 <- length(y)
xbar <- mean(x)
ybar <- mean(y)
sd1 <- sd(x)^2
sd2 <- sd(y)^2
sp <- ((n1-1)*sd1 + (n2-1)*sd2) / (n1+n2-2)
s_sp <- sqrt(sp)
t_test <- (xbar - ybar) / (s_sp * sqrt(1/n1 + 1/n2))
alpha <- 0.05
df <- n1 + n2 - 2
t_crit <- qt(1 - alpha/2, df)
p_value <- 2 * (1 - pt(abs(t_test), df))
CI_lower <- (xbar - ybar) - t_crit * s_sp * sqrt(1/n1 + 1/n2)
CI_upper <- (xbar - ybar) + t_crit * s_sp * sqrt(1/n1 + 1/n2)
if (abs(t_test) > t_crit){
cat("Reject H0")
} else {
cat("Accept H0")
}
set.seed(1245)
x<-rnorm(30, mean=13, sd=3)
y<-rnorm(25, mean=12, sd=3)
#aample statsic
n1=length(x) ; n2<-length(y)
xbar<-mean(x) ; ybar<-mean(y)
sd1<-sd(x)^2; sd2<-sd(y)^2
sp<-((n1-1)*sd1 + (n2 -1)*sd2) / (n1+n2-2)
s_sp<-sqrt(sp)
t_test<-(xbar - ybar)/(s_sp*sqrt((1/n1 + 1/n2)))
alpha<-0.05
df<- n1 + n2 -2
t_crit<- qt(1-alpha/2, df )
p_value<-2*(1- pt(abs(t_test), df))
CI_lower<-(xbar-ybar) - t_crit * s_sp * sqrt(1/n1 + 1 / n2)
CI_upper<-(xbar-ybar) + t_crit * s_sp * sqrt(1/n1 + 1 / n2)
if (abs(t_test) > t_crit){
cat ("reject hapothesis H0")
} else {
cat ("Acc hapothesis H0 ")
}
p_value
weibull_pdf <- function(x, beta, lambda){
(lambda*beta)*(x^(beta-1))*exp(lambda*x^beta)
}
weibull_cdf <- function(x, beta, lambda){
1 - exp(-(x/lambda)^beta)
}
weibull_survival <- function(x, beta, lambda){
exp(-(x/lambda)^beta)
}
weibull_inv <- function(u, beta, lambda){
((-log(1-u))^(1/beta))/lambda
}
r_weibull_costom<-function(n, beta, lambda){
u<-runif(n)
weibull_inv(u, beta, lambda)
}
loglike_weibull<-function(par, x){
beta<-par[1]
lambda<-par[2]
if (beta <= 0 || lambda <= 0) return(-Inf)
sum(log(weibull_pdf(x, beta, lambda)))
}
#optim
mle_weibull <- function(x, start=c(1, 1)){
optim(
par = start,
fn = function(par) -loglike_weibull(par, x),
method = "L-BFGS-B",
lower = c(1e-6, 1e-6)
)
}
beta_true<-2
lambda_ture<-1
n<-500
x<-r_weibull_costom(500, beta_true, lambda_ture)
fit<-mle_weibull(x)
beta_hat<-fit$par[1]
lambda_hat<-fit$par[2]
x<-r_weibull_costom(500, beta_true, lambda_ture)
##########################################
#شبیه سازی از توزیع وایبل
#########################################
# PDF وایبل
weibull_pdf <- function(x, beta, lambda){
beta*lambda *x^(beta - 1) * exp(-lambda * x ^ beta)
}
##########################################
#شبیه سازی از توزیع وایبل
#########################################
# PDF وایبل
weibull_pdf <- function(x, beta, lambda){
beta*lambda *x^(beta - 1) * exp(-lambda * x ^ beta)
}
# CDF وایبل
weibull_cdf <- function(x, beta, lambda){
1 - exp(-(x / lambda)^beta)
}
# تابع بقا
weibull_survival <- function(x, beta, lambda){
exp(-(x / lambda)^beta)
}
# معکوس CDF (Inverse Transform Sampling)
weibull_inv <- function(u, beta, lambda){
lambda * (-log(1 - u))^(1 / beta)
}
# شبیه‌سازی نمونه
r_weibull_custom <- function(n, beta, lambda){
u <- runif(n)
weibull_inv(u, beta, lambda)
}
# لگ‌لایک
loglike_weibull <- function(par, x){
beta <- par[1]
lambda <- par[2]
if (beta <= 0 || lambda <= 0) return(-Inf)
sum(log(weibull_pdf(x, beta, lambda)))
}
# MLE با L-BFGS-B
mle_weibull <- function(x, start = c(1, 1)){
optim(
par = start,
fn = function(par) -loglike_weibull(par, x),
method = "L-BFGS-B",
lower = c(1e-6, 1e-6)
)
}
# شبیه‌سازی داده
beta_true <- 2
lambda_true <- 1
n <- 500
x <- r_weibull_custom(n, beta_true, lambda_true)
# برآورد MLE
fit <- mle_weibull(x)
beta_hat <- fit$par[1]
lambda_hat <- fit$par[2]
# نمایش نتایج
cat("Beta hat:", beta_hat, "\n")
cat("Lambda hat:", lambda_hat, "\n")
